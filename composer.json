{
    "name": "kwasii/livewire-mapcn",
    "description": "Beautiful MapLibre maps for Laravel Livewire, inspired by mapcn: markers, popups, routes with progress, arcs, GeoJSON, clusters and 3D.",
    "keywords": [
        "kwasii",
        "laravel",
        "livewire",
        "livewire-mapcn",
        "maplibre",
        "maps",
        "mapcn",
        "geojson"
    ],
    "homepage": "https://github.com/kwasii/livewire-mapcn",
    "license": "MIT",
    "authors": [
        {
            "name": "Kwasi Sakyi Baidoo",
            "email": "kesbijnr@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "spatie/laravel-package-tools": "^1.93",
        "illuminate/contracts": "^11.0||^12.0||^13.0",
        "livewire/livewire": "^3.0||^4.0"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "nunomaduro/collision": "^8.9",
        "larastan/larastan": "^3.13",
        "orchestra/testbench": "^9.0||^10.0||^11.0",
        "pestphp/pest": "^4.0||^5.0",
        "pestphp/pest-plugin-arch": "^4.0||^5.0",
        "pestphp/pest-plugin-laravel": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "phpstan/phpstan-phpunit": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Kwasii\\LivewireMapcn\\": "src/",
            "Kwasii\\LivewireMapcn\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kwasii\\LivewireMapcn\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "test-js": "node --test \"tests/js/*.test.mjs\""
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kwasii\\LivewireMapcn\\LivewireMapcnServiceProvider"
            ],
            "aliases": {
                "LivewireMapcn": "Kwasii\\LivewireMapcn\\Facades\\LivewireMapcn"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
